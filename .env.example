# 环境变量配置
# 本地开发：复制此文件为 .env.local 并填入真实值
# 生产环境（Cloudflare Workers）：OPENAI_API_KEY 需要作为 Secret 配置

# AI Provider — APIMart（OpenAI 兼容网关，支持多种模型）
# 获取 Key：https://apib.ai/keys
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.apib.ai/v1

# 可选模型：
#   OpenAI: gpt-5, gpt-5-mini
#   Claude: claude-opus-4-8, claude-sonnet-4-6
#   DeepSeek: deepseek-v4-pro, deepseek-v4-flash
#   Gemini: gemini-2.5-pro, gemini-2.5-flash
OPENAI_MODEL=gpt-5

# 数据库路径
DATABASE_PATH=data/mvp-0.1.db

# 应用配置
NEXT_PUBLIC_APP_NAME=AI Personal Planning
NEXT_PUBLIC_APP_VERSION=0.1.0
