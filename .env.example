# 环境变量配置
# 本地开发：复制此文件为 .env.local 并填入真实值
# 生产环境（Cloudflare Workers）：OPENAI_API_KEY 需要作为 Secret 配置（见下方说明）

# AI Provider (OpenAI-compatible)
# 默认使用 DeepSeek，也可以换成任何 OpenAI 兼容供应商
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.deepseek.com/v1

# 可选模型切换
# OPENAI_MODEL=deepseek-chat

# 数据库路径（相对于项目根目录，默认 data/mvp-0.1.db）
DATABASE_PATH=data/mvp-0.1.db

# 应用配置
NEXT_PUBLIC_APP_NAME=AI Personal Planning
NEXT_PUBLIC_APP_VERSION=0.1.0

# ============================================================
# Cloudflare Workers 环境变量配置
# ============================================================
# wrangler.jsonc 中已配置 vars（非敏感环境变量）：
#   OPENAI_MODEL=deepseek-chat
#   OPENAI_BASE_URL=https://api.deepseek.com/v1
#
# API Key 请使用以下命令设置为 Secret（敏感信息不入库）：
#   npx wrangler secret put OPENAI_API_KEY
#   输入: sk-your-deepseek-api-key
# ============================================================
