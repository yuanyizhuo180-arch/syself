{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "syself",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-13",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "OPENAI_MODEL": "gpt-5",
    "OPENAI_BASE_URL": "https://api.apib.ai/v1"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // "routes": [
  //   {
  //     "pattern": "tw4.ip-ddns.com",
  //     "custom_domain": true
  //   }
  // ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "syself-db",
      "database_id": "d4dddc4d-5842-4974-a869-b3a13c655a2e",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
